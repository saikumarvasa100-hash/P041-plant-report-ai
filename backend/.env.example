# Copy to backend/.env and fill in. Never commit .env (it is gitignored).
#
# LIVE MODE (real OpenAI-compatible provider, e.g. OpenRouter, Groq, Ollama, Zen):
#   LLM_PROVIDER=openai-compatible
#   LLM_API_KEY=<your key>        # Bearer token sent as Authorization header
#   LLM_MODEL=<provider model id> # e.g. provider's exact model name
#   LLM_BASE_URL=<provider base>  # client appends /chat/completions itself
LLM_PROVIDER=openai-compatible
LLM_API_KEY=changeme
LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT_S=60
DATABASE_URL=sqlite:///./data/plant.db
